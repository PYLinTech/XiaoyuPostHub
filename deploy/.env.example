# XiaoyuPostHub 配置

# 数据库
DATABASE_URL=

# 超级管理员
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD_HASH=

# Docker
XIAOYUPOSTHUB_IMAGE=pylintech/xiaoyuposthub:latest
XIAOYUPOSTHUB_PORT=8080
# 已有网络设为 true；由 Compose 创建的新网络设为 false
XIAOYUPOSTHUB_NETWORK=xiaoyuposthub-network
XIAOYUPOSTHUB_NETWORK_EXTERNAL=false

# 前端
STATIC_DIR=/app/web

# 站点是否通过 HTTPS 对外提供服务，默认 true。纯 HTTP 部署必须设为 false：
# 否则会话 Cookie 带 Secure 属性浏览器不会回传（登录无法保持），且登录加密
# 要求浏览器在安全上下文（HTTPS / localhost）下访问才能提交。
HTTPS_ENABLED=true

# HSTS：默认启用。响应头只在 HTTPS 上被浏览器采纳，明文部署下会被忽略，
# 纯 HTTP 部署如需完全静默可设为 false。
HSTS_ENABLED=true

# 可信反向代理网段（可选，逗号分隔的 CIDR）。
# 配置后，只有来自这些网段的请求才会采信 X-Real-IP，防止可直连的客户端
# 伪造该头绕过基于 IP 的登录限流；留空表示始终采信 X-Real-IP（适用于服务
# 只经反向代理暴露的部署）。
# 示例：TRUSTED_PROXY_CIDRS=172.17.0.0/16,127.0.0.1/32
TRUSTED_PROXY_CIDRS=
