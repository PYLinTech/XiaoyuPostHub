# XiaoyuPostHub 配置
#
# ⚠️ 改完须重建容器生效：docker compose -p xiaoyuposthub up -d --force-recreate
#    （restart 不重读本文件）；值含 $ 或 # 时用单引号包住。

# 数据库
DATABASE_URL=

# 超级管理员
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD_HASH=

# Docker
XIAOYUPOSTHUB_IMAGE=pylintech/xiaoyuposthub:latest
XIAOYUPOSTHUB_PORT=8080
# 已有网络设为 true；由 Compose 创建的新网络设为 false
XIAOYUPOSTHUB_NETWORK=xiaoyuposthub-network
XIAOYUPOSTHUB_NETWORK_EXTERNAL=false

# 前端
STATIC_DIR=/app/web

# 站点是否通过 HTTPS 对外提供服务，默认 true。纯 HTTP 部署必须设为 false：
# 否则会话 Cookie 带 Secure 属性浏览器不会回传（登录无法保持），且登录加密
# 要求浏览器在安全上下文（HTTPS / localhost）下访问才能提交。
HTTPS_ENABLED=true

# HSTS：默认启用。响应头只在 HTTPS 上被浏览器采纳，明文部署下会被忽略，
# 纯 HTTP 部署如需完全静默可设为 false。
HSTS_ENABLED=true

# 可信反向代理网段（可选，逗号分隔的 CIDR）。
# 配置后，只有来自这些网段的请求才会采信 X-Real-IP，防止可直连的客户端
# 伪造该头绕过基于 IP 的登录限流；留空表示始终采信 X-Real-IP（适用于服务
# 只经反向代理暴露的部署）。
# 示例：TRUSTED_PROXY_CIDRS=172.17.0.0/16,127.0.0.1/32
TRUSTED_PROXY_CIDRS=

# ===== 可选配置（不启用则留空/不写）=====

# 存储加密密钥（启用「加密存储」必需）：keyId:base64(32字节)，多个用逗号分隔
# （第一个加密新文件、其余解密历史）。生成：openssl rand -base64 32
# ⚠️ 丢失即已加密文件永久不可恢复，请离线备份。
# XPH_ENCRYPTION_KEYS=

# 123 云盘凭据（开放平台申请下发）；存储根目录 ID 等在管理端「存储」页配置。
# XPH_PAN123_CLIENT_ID=
# XPH_PAN123_CLIENT_SECRET=

# S3 兼容对象存储凭据（Endpoint/Bucket 等在管理端配置）。
# XPH_S3_ACCESS_KEY_ID=
# XPH_S3_SECRET_ACCESS_KEY=

# 概览页「宿主磁盘」统计的路径（默认 /，容器内即宿主根盘；数据在独立数据盘时可指过去）。
# XPH_HOST_DISK_PATH=

# 程序读取的配置文件路径（默认 deploy/.env），一般无需设置。
# ENV_FILE=
